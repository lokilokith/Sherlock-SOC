# Copy this file to .env for local configuration.
# Keep real credentials, API keys, and tokens out of Git.

# Application
APP_ENV=development
APP_NAME=SHERLOCK

# SQLite persistence
# SHERLOCK_DATABASE_URL=sqlite:///../data/sherlock.db
# Public synthetic read-only database. Keep this separate from analyst data.
# SHERLOCK_DEMO_DATABASE_URL=sqlite:///../data/demo.db

# HTTP and ingestion safety
SHERLOCK_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SHERLOCK_MAX_IMPORT_BYTES=5242880
SHERLOCK_AGENT_MODE=demo

# Authentication
# Demo mode remains read-only for unauthenticated users. On first installation,
# create the administrator with: python -m app.cli bootstrap-admin
# Existing password hashes are preserved across restarts.
SHERLOCK_AUTH_ENABLED=true
SHERLOCK_ANALYST_USERNAME=analyst
SHERLOCK_SESSION_TTL_SECONDS=28800
SHERLOCK_SECURE_COOKIES=false

# CrewAI model configuration. Credentials are read by the configured provider.
# SHERLOCK_LLM_MODEL=
# Provider-specific credentials must be supplied through the provider's
# environment variables and must never be committed here.

SHERLOCK_VIRUSTOTAL_API_KEY=490930f923aa2e2a8602592ae0a2b704fbf34dac9dd4c90833491fd1e27a0aee
SHERLOCK_ABUSEIPDB_API_KEY=
